#include "custom_depth/helper_custom_depth_imgui/helper_imgui_station.hps"
#include "custom_depth/helper_custom_depth_imgui/helper_imgui_station_apps_common.hps"
#include "custom_depth/helper_custom_depth_imgui/helper_imgui_station_app_numpad.hps"

void DrawGeneratedCustomScreen(const tString&in asEntityName, float afTimeStep)
{
	ImGui_SetTransCategory("GeneratedTerminal");

	cImGuiWindowData mainWindowData = StationGui_CreateDefaultWindowData();
	StationGui_DoWindowStart("MyWindowCaption", mainWindowData, ImGui_NrmPos(cVector3f(0.1, 0.1, 1)), ImGui_NrmSize(cVector2f(0.8, 0.72)), true);
		ImGui_DoImage(cImGuiGfx("my_image"), ImGui_NrmPosGroup(cVector3f(0.05, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.35, 0.45)));
		cImGuiTextFrameData bodyTextData = StationGui_CreateDefaultTextFrameData();
		ImGui_DoTextFrameExt("MyTextEntry", 0, 0, 0, bodyTextData, ImGui_NrmPosGroup(cVector3f(0.45, 0.1, 1)), ImGui_NrmSizeGroup(cVector2f(0.5, 0.55)));
		cImGuiButtonData confirmButtonData = StationGui_CreateDefaultButtonData();
		if (ImGui_DoButtonExt("ConfirmButton", "Confirm", confirmButtonData, ImGui_NrmPosGroup(cVector3f(0.7, 0.85, 1)), ImGui_NrmSizeGroup(cVector2f(0.25, 0.1))))
		{
			// TODO: ConfirmButton pressed
		}
	StationGui_DoWindowEnd();
}