{
  "name": "soma-gui-designer",
  "displayName": "SOMA GUI Designer",
  "publisher": "soma-modding",
  "private": true,
  "version": "0.3.0",
  "description": "Visual builder for SOMA (HPL3) ImGui terminal GUIs — drag-and-drop widgets, generate AngelScript .hps code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/soma-modding/soma-gui-designer.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "somaGui.editor",
        "displayName": "SOMA GUI Designer",
        "selector": [
          {
            "filenamePattern": "*.somagui.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "somaGui.newProject",
        "title": "New Project",
        "category": "SOMA GUI"
      },
      {
        "command": "somaGui.toggleWysiwyg",
        "title": "Toggle WYSIWYG Rendering",
        "category": "SOMA GUI"
      },
      {
        "command": "somaGui.configureGraphics",
        "title": "Configure Graphics Paths",
        "category": "SOMA GUI"
      },
      {
        "command": "somaGui.setBaseGameGraphicsPath",
        "title": "Set Base Game Graphics Path",
        "category": "SOMA GUI"
      },
      {
        "command": "somaGui.setModGraphicsPath",
        "title": "Set Mod Graphics Path",
        "category": "SOMA GUI"
      }
    ],
    "configuration": {
      "title": "Canvas & WYSIWYG",
      "properties": {
        "somaGui.baseGameGraphicsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute or workspace-relative path to the **base game** `graphics` folder. Used to render real textures on the WYSIWYG canvas. The mod folder takes precedence over this one."
        },
        "somaGui.modGraphicsPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute or workspace-relative path to your **mod's** `graphics` folder. Files here override the base game when rendering the WYSIWYG canvas."
        },
        "somaGui.wysiwyg.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render real game textures and colors on the canvas (WYSIWYG). When off, widgets show simple placeholder styling."
        }
      }
    }
  },
  "activationEvents": [],
  "scripts": {
    "extract": "tsx scripts/extract-api-schema.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:webview": "vite build",
    "build:extension": "node esbuild.mjs",
    "prebuild": "npm run extract",
    "build": "npm run clean && npm run build:webview && npm run build:extension",
    "watch:webview": "vite build --watch",
    "watch:extension": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run extract && npm run clean && npm run build:webview && node esbuild.mjs --production",
    "package": "vsce package",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
