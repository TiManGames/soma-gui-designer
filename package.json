{
  "name": "soma-gui-designer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Visual builder for SOMA (HPL3) ImGui terminal GUIs — drag-and-drop widgets, generate AngelScript .hps code.",
  "scripts": {
    "extract": "tsx scripts/extract-api-schema.ts",
    "predev": "npm run extract",
    "dev": "vite",
    "prebuild": "npm run extract",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
